function insertNewUser($pdo, $username, $password) {

    $checkUserSql = "SELECT * FROM user_passwords WHERE username = ?";
    $checkUserSqlStmt = $pdo->prepare($checkUserSql);
    $checkUserSqlStmt->execute([$username]);

    if ($checkUserSqlStmt->fetch()) {
        $_SESSION['message'] = "User already exists";
        return false;
    }

    $sql = "INSERT INTO user_passwords (username, password)
            VALUES (?, ?)";

    $stmt = $pdo->prepare($sql);

    if ($stmt->execute([$username, $password])) {
        $_SESSION['message'] = "User successfully inserted";
        return true;
    }

    $_SESSION['message'] = "Error occurred, please try again";
    return false;
}


function loginUser($pdo, $username, $password) {

    $sql = "SELECT * FROM user_passwords WHERE username = ?";
    $stmt = $pdo->prepare($sql);
    $stmt->execute([$username]);

    $userInfoRow = $stmt->fetch(PDO::FETCH_ASSOC);

    if (!$userInfoRow) {
        $_SESSION['message'] = "Username/password invalid";
        return false;
    }

    $passwordFromDB = $userInfoRow['password'];

    // Check passwords stored using password_hash()
    $passwordIsValid = password_verify($password, $passwordFromDB);

    // Support existing SHA-1 accounts during migration
    if (!$passwordIsValid &&
        hash_equals($passwordFromDB, sha1($password))) {

        $newPasswordHash = password_hash($password, PASSWORD_DEFAULT);

        $updateSql = "UPDATE user_passwords
                      SET password = ?
                      WHERE username = ?";

        $updateStmt = $pdo->prepare($updateSql);
        $updateStmt->execute([$newPasswordHash, $username]);

        $passwordIsValid = true;
    }

    if ($passwordIsValid) {
        session_regenerate_id(true);

        $_SESSION['username'] = $userInfoRow['username'];
        $_SESSION['message'] = "Login successful!";

        return true;
    }

    $_SESSION['message'] = "Username/password invalid";
    return false;
}

